<?xml version='1.0' encoding='utf-8'?>
<widget id="com.rahulgupta.duckshooter2" version="3.5" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Duck Shooter 3D</name>
    <description>Duck Shooter 3D Game</description>
    <author email="dev@example.com">Rahul Gupta</author>
    
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Android Target SDK 34 (Indus Appstore / Play Store compliant) -->
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="android-compileSdkVersion" value="34" />

    <!-- Official Free AdMob Plugin with Your App ID -->
    <plugin name="cordova-plugin-admob-plus" spec="^1.28.0">
        <variable name="APP_ID_ANDROID" value="ca-app-pub-1590363558146928~5915974911" />
    </plugin>
</widget>
